          "actor": "student",
          "action": "answer",
          "text": "学生：我记得栈是先进先出？"
        },
        {
          "actor": "agent",
          "action": "explain",
          "text": "栈是后进先出（LIFO），队列才是先进先出（FIFO）。你把两者弄反了（第2章_栈和队列.md p.1）。"
        },
        {
          "actor": "agent",
          "action": "next",
          "text": "📍 下一步：examprep answer q010 right"
        }
      ],
      "evidence_keys": [
        "后进先出（LIFO）"
      ],
      "forbidden": [
